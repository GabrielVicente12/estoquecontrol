{
  "info": {
    "name": "Estoquecontrol - API de estoque",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Execute na ordem. Grupo e produto recebem códigos únicos a cada execução. Fornecedor é opcional. Use ponto nos decimais."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "grupoId",
      "value": ""
    },
    {
      "key": "produtoId",
      "value": ""
    },
    {
      "key": "lancamentoId",
      "value": ""
    },
    {
      "key": "codigo",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 - Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "01 - Cadastrar grupo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/grupos-produtos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Grupo {{codigo}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"codigo\", pm.variables.replaceIn(\"{{$guid}}\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"grupoId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Cadastrar produto",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/produtos",
        "body": {
          "mode": "raw",
          "raw": "{\"codigoBarras\":\"{{codigo}}\",\"descricao\":\"Mouse sem fio\",\"valorUnitario\":89.90,\"estoqueMinimo\":2,\"grupoId\":{{grupoId}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"produtoId\", pm.response.json().id);",
              "pm.test(\"Saldo inicial zero\", () => pm.expect(pm.response.json().saldoEstoque).to.eql(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Entrada de 10",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/lancamentos-estoque",
        "body": {
          "mode": "raw",
          "raw": "{\"produtoId\":{{produtoId}},\"tipo\":\"ENTRADA\",\"quantidade\":10,\"observacao\":\"Compra inicial\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"lancamentoId\", pm.response.json().id);",
              "pm.test(\"Saldo 10\", () => pm.expect(pm.response.json().saldoPosterior).to.eql(10));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Saida de 3",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/lancamentos-estoque",
        "body": {
          "mode": "raw",
          "raw": "{\"produtoId\":{{produtoId}},\"tipo\":\"SAIDA\",\"quantidade\":3,\"observacao\":\"Saida de mercadoria\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Saldo 7\", () => pm.expect(pm.response.json().saldoPosterior).to.eql(7));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Consultar produto",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/produtos/{{produtoId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Saldo 7\", () => pm.expect(pm.response.json().saldoEstoque).to.eql(7));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Listar produtos",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/produtos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Historico do produto",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/lancamentos-estoque?produtoId={{produtoId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Dois lancamentos\", () => pm.expect(pm.response.json()).to.have.lengthOf(2));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - Consultar lancamento",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/lancamentos-estoque/{{lancamentoId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 - Saldo insuficiente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/lancamentos-estoque",
        "body": {
          "mode": "raw",
          "raw": "{\"produtoId\":{{produtoId}},\"tipo\":\"SAIDA\",\"quantidade\":8}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 - Quantidade invalida",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/lancamentos-estoque",
        "body": {
          "mode": "raw",
          "raw": "{\"produtoId\":{{produtoId}},\"tipo\":\"ENTRADA\",\"quantidade\":0}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 - Produto inexistente",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/produtos/9223372036854775807"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 - Codigo duplicado",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/produtos",
        "body": {
          "mode": "raw",
          "raw": "{\"codigoBarras\":\"{{codigo}}\",\"descricao\":\"Duplicado\",\"valorUnitario\":10,\"estoqueMinimo\":0,\"grupoId\":{{grupoId}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 - Saldo preservado apos erros",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/produtos/{{produtoId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Saldo permanece 7\", () => pm.expect(pm.response.json().saldoEstoque).to.eql(7));"
            ]
          }
        }
      ]
    },
    {
      "name": "14 - Historico preservado apos erros",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/lancamentos-estoque?produtoId={{produtoId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Continuam dois lancamentos\", () => pm.expect(pm.response.json()).to.have.lengthOf(2));"
            ]
          }
        }
      ]
    },
    {
      "name": "15 - Listar fornecedores opcionais",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/fornecedores"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
  ]
}
